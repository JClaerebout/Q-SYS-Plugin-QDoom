PluginInfo = {
  Name="Fun~QDoom", Version="0.3.0", BuildVersion="0.3.0",
  Id="a53e94fb-a6ed-4ac3-94d6-5b08e0aad170",
  Author="Jens Claerebout", Description="A small SVG corridor shooter"
}
function GetColor() return {125,32,29} end
function GetPrettyName() return "QDoom 0.3.0" end
function GetProperties() return {} end

local buttons={"Forward","Backward","StrafeLeft","StrafeRight","TurnLeft","TurnRight","Fire","Reset","Run","StepMode"}
function GetControls()
  local c={
    {Name="Screen",ControlType="Button",ButtonType="Toggle",Count=1,UserPin=true,PinStyle="Output"},
    {Name="Info",ControlType="Text",Count=1,UserPin=true,PinStyle="Output"}
  }
  for _,n in ipairs(buttons) do
    c[#c+1]={Name=n,ControlType="Button",ButtonType=(n=="Run" or n=="StepMode") and "Toggle" or "Momentary",Count=1,UserPin=true,PinStyle="Input"}
  end
  return c
end
function GetControlLayout()
  local l={
    Screen={Style="Button",Position={10,10},Size={640,360},Color={0,0,0},Legend="QDoom"},
    Info={Style="Text",Position={10,375},Size={640,30}},
    Forward={Position={100,415},Size={80,38},Legend="Forward"},
    StrafeLeft={Position={10,460},Size={80,38},Legend="Strafe Left"},
    Backward={Position={100,460},Size={80,38},Legend="Backward"},
    StrafeRight={Position={190,460},Size={80,38},Legend="Strafe Right"},
    TurnLeft={Position={300,460},Size={80,38},Legend="Turn Left"},
    TurnRight={Position={390,460},Size={80,38},Legend="Turn Right"},
    Fire={Position={490,415},Size={160,83},Legend="FIRE"},
    Run={Position={10,515},Size={100,38},Legend="Run / Pause"},
    StepMode={Position={120,515},Size={150,38},Legend="Step Mode"},
    Reset={Position={280,515},Size={100,38},Legend="Reset"}
  }
  for _,n in ipairs(buttons) do
    l[n].Style="Button"
    l[n].ButtonStyle=(n=="Run" or n=="StepMode") and "Toggle" or "Momentary"
    l[n].Color={85,35,35}
  end
  return l,{}
end

