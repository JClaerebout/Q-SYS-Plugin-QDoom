  {name="TROOD1",w=50,h=62,left=25,top=58,png=""},
  {name="TROOH1",w=49,h=63,left=26,top=59,png=""},
  {name="TROOM0",w=57,h=26,left=29,top=22,png=""},
  {name="SARGA1",w=38,h=59,left=17,top=55,png=""},
  {name="SARGB1",w=34,h=59,left=17,top=56,png=""},
  {name="SARGC1",w=38,h=59,left=18,top=55,png=""},
  {name="SARGD1",w=38,h=59,left=17,top=55,png=""},
  {name="SARGH1",w=33,h=50,left=15,top=47,png=""},
  {name="SARGN0",w=49,h=29,left=22,top=24,png=""},
}
local GUN_ART={
  {name="PISGA0",w=82,h=92,left=-125,top=-97,png=""},
  {name="PISGB0",w=82,h=96,left=-125,top=-82,png=""},
  {name="PISGC0",w=84,h=100,left=-124,top=-87,png=""},
  {name="PISGD0",w=84,h=106,left=-125,top=-76,png=""},
  {name="PISGE0",w=86,h=120,left=-123,top=-68,png=""},
  {name="PISFA0",w=32,h=30,left=-144,top=-69,png=""},
}
-- END GENERATED FREEDOOM ASSETS

if Controls then
  local W,H,N=320,180,64
  local firstMap={
    "111111111111","100000000001","101110011101","100010000001",
    "100010110001","100000010001","101100010101","100000000001",
    "100111000001","100000000001","111111111111"
  }
  local secondMap={
    "111111111111","100000000001","101111011101","100001000001",
    "111001010101","100000010001","101110010101","100000000001",
    "101011110101","100000000001","111111111111"
  }
  local level=1
  local map=firstMap
  local p,enemies,kills,flash,cooldown,damage,frames,last,hasRun
  local dirty=true
  local shotPending=false
  local weaponFrame=0
  local stage=0
  local parts,z,scene,svgBytes
  local tickCount=0
  local floor,abs,min,max,cos,sin,atan,sqrt=math.floor,math.abs,math.min,math.max,math.cos,math.sin,math.atan,math.sqrt
  local function cell(x,y)
    local row=map[floor(y)+1]
    return not row or row:sub(floor(x)+1,floor(x)+1)~="0"
  end
  local function walk(o,dx,dy)
    local r=.18
    local x,y=o.x+dx,o.y+dy
    if not cell(x-r,o.y-r) and not cell(x+r,o.y+r) and not cell(x-r,o.y+r) and not cell(x+r,o.y-r) then o.x=x end
    if not cell(o.x-r,y-r) and not cell(o.x+r,y+r) and not cell(o.x-r,y+r) and not cell(o.x+r,y-r) then o.y=y end
  end
  -- Grid-crossing DDA. The side and fractional hit position select texture bands.
  local function ray(a,limit)
    local dx,dy=cos(a),sin(a)
    local mx,my=floor(p.x),floor(p.y)
    local ddx=abs(dx)>1e-8 and abs(1/dx) or 1e30
    local ddy=abs(dy)>1e-8 and abs(1/dy) or 1e30
    local sx,sy=dx<0 and -1 or 1,dy<0 and -1 or 1
    local tx=(dx<0 and p.x-mx or mx+1-p.x)*ddx
    local ty=(dy<0 and p.y-my or my+1-p.y)*ddy
    for _=1,24 do
      local d,side
      if tx<ty then d=tx;tx=tx+ddx;mx=mx+sx;side=0
      else d=ty;ty=ty+ddy;my=my+sy;side=1 end
      if d>limit then break end
      local row=map[my+1]
      if not row or row:sub(mx+1,mx+1)~="0" then
        return d,p.x+dx*d,p.y+dy*d,side,(floor(mx/3)+floor(my/3)*3)%#WALL_ART
      end
    end
    return limit,p.x+dx*limit,p.y+dy*limit,0,0
  end
  local function angle(a) return (a+math.pi)%(2*math.pi)-math.pi end
  local function reset(nextLevel)
    level=nextLevel or 1
    map=level==1 and firstMap or secondMap
    p={x=2.5,y=1.5,a=0,hp=100}
    enemies={{x=7.5,y=1.5,hp=2,kind=1},{x=9.5,y=5.5,hp=2,kind=2},{x=3.5,y=7.5,hp=2,kind=1},{x=8.5,y=9.5,hp=2,kind=2}}
    if level==2 then
      p.x=1.5
      enemies={{x=8.5,y=1.5,hp=2,kind=2},{x=3.5,y=3.5,hp=2,kind=1},
        {x=9.5,y=3.5,hp=2,kind=2},{x=2.5,y=5.5,hp=2,kind=1},
        {x=8.5,y=7.5,hp=2,kind=2},{x=5.5,y=9.5,hp=2,kind=1}}
    end
    -- Discard the previous level's partially assembled image.
    stage=0;parts=nil;z=nil;scene=nil;svgBytes=nil
    kills=0;flash=0;cooldown=0;damage=0;frames=0;last=Timer.Now();dirty=true;shotPending=false;weaponFrame=0
  end
  local function move(n,dt)
    if p.hp<=0 or kills==#enemies then return end
    local c,s=cos(p.a),sin(p.a)
    local v=dt*1.8
    if n=="Forward" then walk(p,c*v,s*v)
    elseif n=="Backward" then walk(p,-c*v,-s*v)
    elseif n=="StrafeLeft" then walk(p,s*v,-c*v)
    elseif n=="StrafeRight" then walk(p,-s*v,c*v)
    elseif n=="TurnLeft" then p.a=p.a-dt*.7
    elseif n=="TurnRight" then p.a=p.a+dt*.7 end
    dirty=true
  end
  local function fire()
    if p.hp<=0 or cooldown>0 or kills==#enemies then return end
    cooldown=.35;flash=.18;shotPending=true;dirty=true
    local target,best=nil,20
    for _,e in ipairs(enemies) do
      if e.hp>0 then
        local dx,dy=e.x-p.x,e.y-p.y
        local d=sqrt(dx*dx+dy*dy)
        local a=atan(dy,dx)
        if d<best and abs(angle(a-p.a))<atan(.30/d) and ray(a,d+.1)>d-.1 then target=e;best=d end
      end
    end
    if target then
      target.hp=target.hp-1;target.blood=true;target.hitPending=true
      if target.hp<=0 then kills=kills+1 end
    end
  end
  local function update(dt,ai)
    if flash>0 and flash<=dt then dirty=true end
    cooldown=max(0,cooldown-dt);flash=max(0,flash-dt);damage=max(0,damage-dt)
    if ai and p.hp>0 and kills<#enemies then
      for _,e in ipairs(enemies) do
        if e.hp>0 then
          local dx,dy=p.x-e.x,p.y-e.y
          local d=sqrt(dx*dx+dy*dy)
          if d<.65 then p.hp=max(0,p.hp-6*dt);damage=.2;dirty=true
          elseif d<7 then walk(e,dx/d*dt*.35,dy/d*dt*.35);dirty=true end
        end
      end
    end
  end
  local function rect(x,y,w,h,col)
    if y>=H or y+h<=0 or w<=0 or h<=0 then return end
    parts[#parts+1]=string.format('<rect x="%.1f" y="%.1f" width="%.1f" height="%.1f" fill="%s"/>',x,y,w,h,col)
  end
  local function txt(x,y,s,col,size)
    parts[#parts+1]=string.format('<text x="%d" y="%d" fill="%s" font-family="monospace" font-size="%d">%s</text>',x,y,col,size or 10,s)
  end
  local texChars="0123456789ABCDEFGHIJKLMNOPQRSTUV"
  local texIndex={}
  for i=1,#texChars do texIndex[texChars:sub(i,i)]=i end
  for _,art in ipairs(WALL_ART) do
    art.dark={};art.far={}
    for i,color in ipairs(art.palette) do
      local r=tonumber(color:sub(2,3),16)
      local g=tonumber(color:sub(4,5),16)
      local b=tonumber(color:sub(6,7),16)
      art.dark[i]=string.format("#%02x%02x%02x",floor(r*.72),floor(g*.72),floor(b*.72))
      art.far[i]=string.format("#%02x%02x%02x",floor(r*.58),floor(g*.58),floor(b*.58))
    end
  end
  local function wallColumn(i)
    local camera=2*((i-.5)/N)-1
    local offset=atan(camera*.66)
    local d,x,y,side,kind=ray(p.a+offset,18)
    d=max(.08,d*cos(offset));z[i]=d
    local height=min(220,125/d)
    local top=(H-height)/2
    local frac=(side==0 and y or x)%1
    local art=WALL_ART[kind+1]
    local tx=min(32,floor(frac*32)+1)
    local pal=d>8 and art.far or (side==1 and art.dark or art.palette)
    local bands=d<2.5 and 14 or (d<5 and 10 or 6)
    local px=(i-1)*5
    local bandHeight=height/bands
    for band=0,bands-1 do
      local ty=min(32,floor((band+.5)*32/bands)+1)
      local token=art.rows[ty]:sub(tx,tx)
      rect(px,top+band*bandHeight,5.1,bandHeight+.2,pal[texIndex[token]])
    end
  end
  -- Static PNG art rides inside the SVG; a tiny clip mask handles wall occlusion.
  local function pngImage(art,x,y,w,h,clip)
    parts[#parts+1]=string.format('<image x="%.1f" y="%.1f" width="%.1f" height="%.1f" href="data:image/png;base64,%s" preserveAspectRatio="none"%s/>',x,y,w,h,art.png,clip and (' clip-path="url(#'..clip..')"') or '')
  end
  local function sprite(e,index)
    local dx,dy=e.x-p.x,e.y-p.y
    local distance=sqrt(dx*dx+dy*dy)
    local a=angle(atan(dy,dx)-p.a)
    local d=distance*cos(a)
    if d<=.15 or abs(a)>1.05 then return end
    local sx=W/2+math.tan(a)/.66*W/2
    local h=min(160,120/d)
    local dead=e.hp<=0
    local pose=dead and 6 or (e.hitPending and 5 or (floor(Timer.Now()*4)%4+1))
    local art=MONSTER_ART[(e.kind-1)*6+pose]
    local width=h*art.w/60
    local ground=H/2+h/2
    local bodyHeight=h*art.h/60
    local top=ground-bodyHeight
    local first=max(1,floor((sx-width/2)/5)+1)
    local last=min(N,floor((sx+width/2)/5)+1)
    local clip={};local visible=0
    for i=first,last do
      local x=(i-.5)*5
      if x>=sx-width/2 and x<=sx+width/2 and d<z[i] then
        visible=visible+1
        clip[#clip+1]=string.format('<rect x="%d" y="0" width="5.1" height="180"/>',(i-1)*5)
      end
    end
    if visible>0 then
      local id="monster"..index
      parts[#parts+1]='<defs><clipPath id="'..id..'">'..table.concat(clip)..'</clipPath></defs>'
      parts[#parts+1]='<g data-monster="'..(e.kind==1 and 'TROO' or 'SARG')..'" data-pose="'..art.name..'" clip-path="url(#'..id..')">'
      if dead then
        parts[#parts+1]=string.format('<ellipse data-effect="blood-pool" cx="%.1f" cy="%.1f" rx="%.1f" ry="%.1f" fill="#650c12"/>',sx,ground,width*.62,h*.075)
        parts[#parts+1]='<g data-effect="corpse">'
        pngImage(art,sx-width/2,top,width,bodyHeight)
        parts[#parts+1]='</g>'
      else
        pngImage(art,sx-width/2,top,width,bodyHeight)
      end
      if e.blood then
        rect(sx-width*.13,top+bodyHeight*.48,width*.21,bodyHeight*.22,"#a50e19")
        rect(sx+width*.05,top+bodyHeight*.60,width*.12,bodyHeight*.16,"#650c12")
      end
      if e.hitPending then
        parts[#parts+1]=string.format('<path data-effect="blood-hit" d="M %.1f %.1f l %.1f %.1f l %.1f %.1f M %.1f %.1f l %.1f %.1f" stroke="#e32636" stroke-width="2" fill="none"/>',sx,top+bodyHeight*.5,-width*.45,-h*.12,width*.1,h*.24,sx,top+bodyHeight*.5,width*.4,-h*.15)
        e.hitPending=false;dirty=true
      end
      parts[#parts+1]='</g>'
    end
  end
  local function overlay()
    local order={}
    for _,e in ipairs(enemies) do
      e.dist=(e.x-p.x)^2+(e.y-p.y)^2;order[#order+1]=e
    end
    table.sort(order,function(a,b) return a.dist>b.dist end)
    for i,e in ipairs(order) do sprite(e,i) end
    -- Advance on rendered frames so the staged renderer cannot skip recoil poses.
    if shotPending then weaponFrame=1 end
    local art=GUN_ART[weaponFrame+1]
    local function weaponImage(frame)
      local scale=.6
      pngImage(frame,160+(-frame.left-166)*scale,166+(-frame.top-189)*scale,frame.w*scale,frame.h*scale)
    end
    parts[#parts+1]=string.format('<g data-weapon="handgun" data-frame="%s">',art.name)
    weaponImage(art)
    if weaponFrame==1 then
      parts[#parts+1]='<g data-effect="muzzle-flash">'
      weaponImage(GUN_ART[6])
      parts[#parts+1]='</g>'
    end
    parts[#parts+1]='</g>'
    if weaponFrame>0 then weaponFrame=(weaponFrame+1)%5;dirty=true end
    if shotPending then shotPending=false;dirty=true end
    rect(157,88,6,1,"#ffffff");rect(160,85,1,7,"#ffffff")
    for y,row in ipairs(map) do
      for x=1,#row do if row:sub(x,x)~="0" then rect(4+(x-1)*3,4+(y-1)*3,3,3,"#68696c") end end
    end
    rect(4+p.x*3-1,4+p.y*3-1,2,2,"#00ff8a")
    for _,e in ipairs(enemies) do if e.hp>0 then rect(4+e.x*3-1,4+e.y*3-1,2,2,"#ff3333") end end
    rect(0,166,320,14,"#171719");rect(0,166,320,2,"#68584b")
    rect(5,170,58,7,"#3a2928")
    rect(5,170,58*max(0,p.hp)/100,7,p.hp>30 and "#a34635" or "#d1271e")
    txt(68,177,"HEALTH "..math.ceil(p.hp).."  KILLS "..kills.."/"..#enemies,"#e4d3a8")
    txt(251,177,"LEVEL "..level,"#9b6546",9)
    if p.hp<=0 or kills==#enemies or not Controls.Run.Boolean then
      rect(55,65,210,40,"#191919")
      local prompt=p.hp<=0 and "YOU DIED - RESET" or (kills==#enemies and (level==1 and "CLEAR - FIRE FOR LV2" or "YOU WIN - RESET") or (hasRun and "PAUSED - PRESS RUN" or "PRESS RUN TO PLAY"))
      txt(70,90,prompt,"#ffcc88",16)
    end
    if damage>0 then rect(0,0,320,3,"#ff2222") end
  end
  local function renderStage()
    if stage==0 then
      if not dirty then return end
      dirty=false;parts={'<svg xmlns="http://www.w3.org/2000/svg" width="320" height="180" viewBox="0 0 320 180">'};z={}
      rect(0,0,W,H,"#292b32");rect(0,90,W,90,"#444037")
      stage=1
    elseif stage<=4 then
      local first=(stage-1)*16+1
      for i=first,first+15 do wallColumn(i) end
      stage=stage+1
    elseif stage==5 then overlay();parts[#parts+1]='</svg>';stage=6
    elseif stage==6 then scene=table.concat(parts);parts=nil;stage=7
    elseif stage==7 then svgBytes=Crypto.Base64Encode(scene);stage=8
    else
      Controls.Screen.Legend='{"DrawChrome":false,"IconData":"'..svgBytes..'"}'
      frames=frames+1
      Controls.Info.String=string.format("Frame %d | SVG %.1f KB | %s | %s",frames,#scene/1024,Controls.StepMode.Boolean and "STEP" or "LIVE",Controls.Run.Boolean and "Running" or "Paused")
      scene=nil;svgBytes=nil;stage=0
    end
  end
  QDoomTimer=Timer.New()
  QDoomTimer.EventHandler=function()
    local ok,err=pcall(function()
      local now=Timer.Now()
      local dt=min(.25,max(0,now-last));last=now
      tickCount=tickCount+1
      if Controls.Run.Boolean then
        if not Controls.StepMode.Boolean then
          for i=1,6 do local n=buttons[i];if Controls[n].Boolean then move(n,dt) end end
          if Controls.Fire.Boolean then fire() end
        end
        update(dt,not Controls.StepMode.Boolean)
      end
      -- A new input during rendering is incorporated in the following frame.
      renderStage()
    end)
    if not ok then
      QDoomTimer:Stop();Controls.Run.Boolean=false
      Controls.Info.String="Stopped: "..tostring(err)
      print("QDoom: "..tostring(err))
    end
  end
  for _,n in ipairs(buttons) do
    local name=n
    Controls[name].EventHandler=function(c)
      if name=="Run" then
        hasRun=hasRun or c.Boolean
        last=Timer.Now();dirty=true
      elseif name=="Reset" and c.Boolean then
        reset()
      elseif name=="StepMode" then dirty=true
      elseif c.Boolean and Controls.Run.Boolean then
        if name=="Fire" then
          if p.hp>0 and kills==#enemies and level==1 then reset(2)
          else fire() end
        elseif Controls.StepMode.Boolean then move(name,.22);update(.2,false) end
      end
    end
  end
  Controls.Run.Boolean=false;Controls.StepMode.Boolean=true
  hasRun=false;reset()
  Controls.Info.String="QDoom loading | STEP | Press Run"
  QDoomTimer:Start(.05)
end
